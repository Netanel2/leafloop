rules_version = '2';
// כללי האבטחה של LeafLoop. מדביקים את כל הקובץ הזה ב-Firebase > Firestore > Rules ולוחצים Publish.
service cloud.firestore {
  match /databases/{database}/documents {
    function signed() { return request.auth != null; }
    function me() { return request.auth.uid; }
    function matchUsers(id) { return get(/databases/$(database)/documents/matches/$(id)).data.users; }

    // פרופילים: כולם רואים, רק הבעלים משנה
    match /users/{uid} {
      allow read: if signed();
      allow create, update, delete: if signed() && me() == uid;
      // מידע פרטי (החלקות, שמורים, חסומים): רק הבעלים
      match /private/{docId} {
        allow read, write: if signed() && me() == uid;
      }
    }

    // צמחים ותמונות: כולם רואים, רק הבעלים כותב
    match /plants/{id} {
      allow read: if signed();
      allow create: if signed() && request.resource.data.ownerId == me();
      allow update: if signed() && resource.data.ownerId == me() && request.resource.data.ownerId == me();
      allow delete: if signed() && resource.data.ownerId == me();
    }
    match /photos/{id} {
      allow read: if signed();
      allow create: if signed() && request.resource.data.ownerId == me();
      allow update, delete: if signed() && resource.data.ownerId == me();
    }

    // לייקים: רואים רק מי שעשה ומי שקיבל
    match /likes/{id} {
      allow read: if signed() && (resource.data.from == me() || resource.data.to == me());
      allow create, update: if signed() && request.resource.data.from == me();
      allow delete: if signed() && resource.data.from == me();
    }

    // התאמות וצ'אט: רק שני המשתתפים
    match /matches/{id} {
      allow read: if signed() && (resource == null || me() in resource.data.users);
      allow create: if signed() && me() in request.resource.data.users && request.resource.data.users.size() == 2;
      allow update: if signed() && me() in resource.data.users && request.resource.data.users == resource.data.users;
      match /messages/{mid} {
        allow read: if signed() && me() in matchUsers(id);
        allow create: if signed() && request.resource.data.from == me() && me() in matchUsers(id);
      }
    }

    // הצעות החלפה: רק השולח והמקבל
    match /requests/{id} {
      allow read: if signed() && (resource.data.from == me() || resource.data.to == me());
      allow create: if signed() && request.resource.data.from == me();
      allow update: if signed() && (resource.data.from == me() || resource.data.to == me());
      allow delete: if signed() && resource.data.from == me();
    }

    // דירוגים: רק מי שהשתתף בהחלפה יכול לדרג
    match /reviews/{id} {
      allow read: if signed();
      allow create: if signed() && request.resource.data.from == me()
        && me() in matchUsers(request.resource.data.matchId)
        && request.resource.data.to in matchUsers(request.resource.data.matchId);
    }

    // דיווחים: אפשר רק לשלוח
    match /reports/{id} {
      allow create: if signed() && request.resource.data.from == me();
    }
  }
}
