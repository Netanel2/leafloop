{
  "name": "leafloop",
  "main": "worker.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    // קבצים פנימיים: השרת חוסם אותם גם אם הם הועלו בטעות
    "run_worker_first": ["/.*", "/wrangler.jsonc", "/worker.js", "/README.md", "/firestore.rules", "/_redirects", "/vercel.json"]
  },
  "observability": { "enabled": true },
  "keep_vars": true
}
