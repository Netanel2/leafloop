rules_version = '2';
// כללי האבטחה של LeafLoop. מדביקים את כל הקובץ הזה ב-Firebase > Firestore > Rules ולוחצים Publish.
service cloud.firestore {
  match /databases/{database}/documents {
    function signed() { return request.auth != null; }
    function me() { return request.auth.uid; }
    function matchUsers(id) { return get(/databases/$(database)/documents/matches/$(id)).data.users; }
    function email() { return request.auth.token.email.lower(); }
    // מנהל האפליקציה (אותו אימייל כמו ADMIN_EMAILS ב-app.js)
    function isAdmin() { return signed() && request.auth.token.email_verified == true && email() in ['netanelkk9@gmail.com']; }
    function ownsNursery(nid) { return get(/databases/$(database)/documents/nurseries/$(nid)).data.ownerEmail == email(); }

    // פרופילים: כולם רואים, רק הבעלים משנה
    match /users/{uid} {
      allow read: if signed();
      allow create: if signed() && me() == uid && request.resource.data.get('banned', false) == false;
      // המשתמש מעדכן את עצמו, אבל לא יכול לבטל השעיה. המנהל יכול רק להשעות או לבטל השעיה.
      allow update: if (signed() && me() == uid && request.resource.data.get('banned', false) == resource.data.get('banned', false))
        || (isAdmin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['banned']));
      allow delete: if signed() && me() == uid;
      // מידע פרטי (החלקות, שמורים, חסומים): רק הבעלים
      match /private/{docId} {
        allow read, write: if signed() && me() == uid;
      }
    }

    // צמחים ותמונות: כולם רואים, רק הבעלים כותב
    match /plants/{id} {
      allow read: if signed();
      allow create: if signed() && request.resource.data.ownerId == me();
      allow update: if signed() && resource.data.ownerId == me() && request.resource.data.ownerId == me();
      allow delete: if signed() && resource.data.ownerId == me();
    }
    match /photos/{id} {
      allow read: if signed();
      allow create: if signed() && request.resource.data.ownerId == me();
      allow update, delete: if signed() && resource.data.ownerId == me();
    }

    // לייקים: רואים רק מי שעשה ומי שקיבל
    match /likes/{id} {
      allow read: if signed() && (resource.data.from == me() || resource.data.to == me());
      allow create, update: if signed() && request.resource.data.from == me();
      allow delete: if signed() && resource.data.from == me();
    }

    // התאמות וצ'אט: רק שני המשתתפים
    match /matches/{id} {
      allow read: if isAdmin() || (signed() && (resource == null || me() in resource.data.users));
      allow create: if signed() && me() in request.resource.data.users && request.resource.data.users.size() == 2;
      allow update: if signed() && me() in resource.data.users && request.resource.data.users == resource.data.users;
      match /messages/{mid} {
        allow read: if signed() && me() in matchUsers(id);
        allow create: if signed() && request.resource.data.from == me() && me() in matchUsers(id);
      }
    }

    // הצעות החלפה: רק השולח והמקבל
    match /requests/{id} {
      allow read: if isAdmin() || (signed() && (resource.data.from == me() || resource.data.to == me()));
      allow create: if signed() && request.resource.data.from == me();
      allow update: if signed() && (resource.data.from == me() || resource.data.to == me());
      allow delete: if signed() && resource.data.from == me();
    }

    // דירוגים: רק מי שהשתתף בהחלפה יכול לדרג
    match /reviews/{id} {
      allow read: if signed();
      allow create: if signed() && request.resource.data.from == me()
        && me() in matchUsers(request.resource.data.matchId)
        && request.resource.data.to in matchUsers(request.resource.data.matchId);
    }

    // משתלות: כולם רואים. רק המנהל יוצר, מפעיל ומשהה. בעל/ת המשתלה מעדכן/ת פרטים.
    match /nurseries/{id} {
      allow read: if signed();
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (signed() && resource.data.ownerEmail == email()
        && request.resource.data.ownerEmail == resource.data.ownerEmail
        && request.resource.data.active == resource.data.active);
    }

    // הצעות של משתלות: כולם רואים. רק בעל/ת המשתלה מפרסם/ת. כל משתמש יכול רק להוסיף צפייה או לחיצה.
    match /promos/{id} {
      allow read: if signed();
      allow create: if signed() && request.resource.data.ownerEmail == email() && ownsNursery(request.resource.data.nurseryId);
      allow update: if isAdmin()
        || (signed() && resource.data.ownerEmail == email() && request.resource.data.ownerEmail == email())
        || (signed() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['views', 'clicks']));
      allow delete: if isAdmin() || (signed() && resource.data.ownerEmail == email());
    }

    // בקשות הצטרפות של משתלות
    match /nurseryApplications/{id} {
      allow create: if signed() && request.resource.data.uid == me() && request.resource.data.email == email();
      allow read: if isAdmin() || (signed() && resource.data.uid == me());
      allow update, delete: if isAdmin();
    }

    // שיחות קוליות: רק שני המשתתפים. אפשר להתקשר רק למי שיש איתו התאמה.
    match /calls/{id} {
      allow read: if isAdmin() || (signed() && (resource.data.from == me() || resource.data.to == me()));
      allow create: if signed() && request.resource.data.from == me()
        && me() in matchUsers(request.resource.data.matchId)
        && request.resource.data.to in matchUsers(request.resource.data.matchId);
      allow update: if signed() && (resource.data.from == me() || resource.data.to == me())
        && request.resource.data.from == resource.data.from && request.resource.data.to == resource.data.to;
      match /cands/{cid} {
        allow read, create: if signed() && (get(/databases/$(database)/documents/calls/$(id)).data.from == me()
          || get(/databases/$(database)/documents/calls/$(id)).data.to == me());
      }
    }

    // דיווחים: אפשר רק לשלוח
    match /reports/{id} {
      allow create: if signed() && request.resource.data.from == me();
      allow read, update: if isAdmin();
    }
  }
}
